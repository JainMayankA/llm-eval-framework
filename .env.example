# Copy to .env and fill in
# At least one model key required; others optional
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-key

# API server demo options
# If OPENAI_API_KEY is set, the API uses real OpenAI models by default.
EVAL_OPENAI_MODELS=gpt-4o-mini

# Local Ollama models (comma-separated). Only used when OPENAI_API_KEY is absent.
# Requires Ollama running at localhost:11434 with the model already pulled.
# Example: ollama pull llama3.2
EVAL_OLLAMA_MODELS=llama3.2

# Use heuristic scoring by default. Set to llm-judge for a stronger, costlier
# factuality evaluation that asks a separate OpenAI model to grade answers.
EVAL_FACTUALITY_SCORER=heuristic
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_JUDGE_MAX_TOKENS=256

# Use heuristic safety by default. Set to openai-moderation for provider-backed
# safety classification while keeping local prompt-injection checks.
EVAL_SAFETY_SCORER=heuristic
EVAL_MODERATION_MODEL=omni-moderation-latest

# Provider reliability controls
EVAL_PROVIDER_TIMEOUT_SECONDS=30
EVAL_PROVIDER_MAX_RETRIES=2

# Force the API server to use mock models even when keys are present.
EVAL_USE_MOCK=false

# CLI: use --mock to run without any API keys.
